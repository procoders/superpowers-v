.DS_Store
*.log
node_modules/
.env
.env.local
docs/superpowers/_runs/

# Compound V orchestrator run artifacts.
# Worktrees live under $TMPDIR/compound-v/<run-id>/<job-id> (outside the repo) by
# design; these guards catch any that accidentally land in-tree, plus the codex
# adapter's transient last-message capture. The committed audit trail
# (docs/superpowers/execution/<run-id>/manifest.yaml, state.json, results/) and
# docs/superpowers/memory/ are intentionally NOT ignored.
.worktrees/
/compound-v/
.job_result.txt

# The committed run substrate must NEVER be ignored — the scope gate uses
# `git ls-files --others --exclude-standard`, which skips gitignored paths, so an
# over-broad ignore here would blind enforcement. Un-ignore explicitly to be safe.
!docs/superpowers/execution/
!docs/superpowers/memory/
# Trigger 0 recon docs — defense-in-depth; must stay visible to the scope gate.
!docs/superpowers/recon/

# Generated observability dashboard (v2.15 `compound-v-dashboard.py emit`) — a build
# artifact rendered from the run/epic JSON, not source. Regenerate on demand.
docs/superpowers/execution/dashboard.html

# Codex --json event streams: transient run telemetry (liveness reads them live);
# large and full of prompts/tool-calls — never committed as run substrate.
docs/superpowers/execution/*/logs/*.jsonl
.v29-worktrees/
docs/superpowers/execution/2026-07-11-v2.9-pre-evaluation/baselines/

# stray CLI stderr captures (e.g. agy/models probes)
*.err

# Harness-created agent worktrees. The existing `.worktrees/` guard above predates
# them and does not match this path. Ignoring them is deliberate and has a stated
# trade-off, per the scope-gate warning above: an ignored path is invisible to
# `git ls-files --others --exclude-standard`, so the gate can no longer see a job
# that writes INTO another agent's tree. That case is covered earlier and better —
# hooks/lane-guard.sh denies a cross-tree write BEFORE it happens. What ignoring
# buys is that every concurrent job stops having to hand-snapshot its siblings'
# checkouts into --preexisting just to measure its own diff, and that a local
# `lint-frontmatter.py .` stops reporting dozens of phantom issues from files that
# are not in this checkout at all (observed three times: 51, 68, 68).
.claude/worktrees/

# Python bytecode. A local run of the repo's own test sweep with a
# bytecode-writing interpreter leaves .pyc files next to the scripts.
#
# Ignoring these does NOT hide arbitrary ignored paths from the scope gate — its
# third term is `git ls-files --others --ignored --exclude-standard` precisely so
# a worker cannot escape it by writing a gitignored path. As of 3.4.0 the gate
# itself drops *.pyc / *.pyo BY EXTENSION (scripts/compound-v-scope-check.py,
# is_bytecode_noise) because bytecode is interpreter output, never work, and never
# merged; anything else under __pycache__/ still counts. PYTHONDONTWRITEBYTECODE=1
# (CI exports it; worker scripts set it) remains the hygiene that keeps the tree
# quiet in the first place.
__pycache__/
*.pyc
