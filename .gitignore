# Harness-created agent worktrees
.claude/worktrees/

# Local-scope subagent memory (`memory: local`) is never checked in
.claude/agent-memory-local/

# Transient telemetry kept out of the archived v3 audit trail
docs/archive/v3/execution/*/logs/*.jsonl
docs/archive/v3/**/.run.lock
docs/archive/v3/**/lane-map.json
