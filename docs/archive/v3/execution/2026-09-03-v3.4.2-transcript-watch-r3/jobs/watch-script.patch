+def strip_heredocs(command):
+    """`command` with every heredoc BODY removed, openers left in place.
+
+    A heredoc body is DATA, not command text: an agent writing a Python file
+    with `cat > f.py <<PYEOF ... PYEOF` was reported as redirecting into `=`,
+    because `assert s.count(old) >= 1` inside the body tokenized as a `>`
+    followed by a word. Only the heredoc's own redirect target is a write.
+    """
+    if not isinstance(command, str) or "<<" not in command:
+        return command
+    lines = command.split("\n")
+    kept = []
+    i = 0
+    while i < len(lines):
+        line = lines[i]
+        kept.append(line)
+        i += 1
+        delims = [(m.group(1) or m.group(2) or m.group(3))
+                  for m in _HEREDOC.finditer(line)]
+        for delim in [d for d in delims if d]:
+            while i < len(lines) and lines[i].strip() != delim:
+                i += 1
+            if i < len(lines):  # the terminator line itself
+                i += 1
+    return "\n".join(kept)
