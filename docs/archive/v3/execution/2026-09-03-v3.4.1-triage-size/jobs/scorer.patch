+# paths a DIRECT change may be committed on with no human offer, and the line budget for one.
+# Both are fail-closed by absence: omit them and nothing auto-routes. A path that is BOTH
+# allowed and sensitive is refused (predicate 5 — sensitive wins).
+#
+# auto_route_allow:
+#   - "CHANGELOG.md"
+# auto_route_max_lines: 20
+
