+# --------------------------------------------------------------------------- #
+# Finding 105 — bookkeeping paths are not blast radius. A stale run leaves
+# `docs/superpowers/execution/*/.run.lock` (and similar) behind as changed or
+# untracked paths; the gate exempts them from the lane check, but until this fix
+# `resolve_test_commands` counted every one as an UNMAPPED changed path and
+# promoted an already-scoped slice straight to `full_command` — the same
+# full-suite run that hit `TEST_TIMEOUT_S` in finding 102's probe.
+#
+# This is deliberately narrower than `_is_test_noise` above: it applies to the
+# unmapped ⇒ `full_command` promotion ONLY (never to the impacted/newly-added
+# command sets, and never to the lane check, which stays unchanged), and it
+# drops exactly two shapes — this project's own run-directory bookkeeping, and
+# whatever git actually ignores (one `check-ignore --stdin` call, never a
+# heuristic standing in for it).
+# --------------------------------------------------------------------------- #
+_BOOKKEEPING_PREFIX = "docs/superpowers/execution/"
+
+
+def _is_bookkeeping_path(rel):
+    r = str(rel or "")
+    while r.startswith("./"):
+        r = r[2:]
+    return r.startswith(_BOOKKEEPING_PREFIX)
+
+
+def _drop_bookkeeping_unmapped(worktree, paths):
+    """``paths`` minus BOOKKEEPING NOISE, for the unmapped ⇒ ``full_command``
+    promotion ONLY (finding 105). Returns ``(kept, ignored_count)``, order preserved.
+
+    Two shapes are dropped: paths under ``docs/superpowers/execution/**`` (this
+    project's own run-directory bookkeeping — manifests, job results, `.run.lock`
+    files a stale run can leave as changed/untracked), and anything git actually
+    ignores, decided by ONE ``git check-ignore --stdin`` call over the rest.
+
+    When ``worktree`` is falsy, or the git call fails, the gitignore half is
+    skipped and those paths stay counted as unmapped — fail TOWARD still
+    promoting to `full_command`, the same safe direction every other
+    fail-closed rule in this file takes; only the two NAMED shapes are ever
+    dropped, never "whatever git ignores" read alone as "not blast radius"."""
+    paths = list(paths or [])
+    if not paths:
+        return paths, 0
+    bookkeeping = {p for p in paths if _is_bookkeeping_path(p)}
+    rest = [p for p in paths if p not in bookkeeping]
+    ignored_git = set()
+    if worktree and rest:
+        try:
+            proc = subprocess.Popen(
+                ["git", "-C", worktree, "check-ignore", "--stdin"],
+                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                universal_newlines=True)
+            out, _ = proc.communicate("\n".join(rest) + "\n", timeout=30)
+            if proc.returncode in (0, 1):
+                ignored_git = {ln.strip() for ln in (out or "").splitlines() if ln.strip()}
+        except Exception:  # noqa: BLE001 — fail toward NOT dropping (see docstring)
+            ignored_git = set()
+    ignored = bookkeeping | ignored_git
+    kept = [p for p in paths if p not in ignored]
+    return kept, len(ignored)
+
+
