+              "evidence": evidence[:RECALL_EVIDENCE_MAX],
+              "recall_check_ms": _recall_ms(started)}
+    k = doc.get("k")
+    if isinstance(k, int) and not isinstance(k, bool):
+        result["k"] = k
+    return result
