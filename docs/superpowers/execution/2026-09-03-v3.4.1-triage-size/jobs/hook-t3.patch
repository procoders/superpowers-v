diff --git a/tests/test-native-points.sh b/tests/test-native-points.sh
index 8ea9cd5..a5897de 100755
--- a/tests/test-native-points.sh
+++ b/tests/test-native-points.sh
@@ -84,6 +84,17 @@ export PYTHONDONTWRITEBYTECODE=1
 # How the hooks actually run: the harness always sets this, and it is what
