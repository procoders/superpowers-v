+def _retire_run_lock(run_dir):
+    """Delete the run's OWN `.run.lock` at the same TERMINAL phase transition
+    that retires lane-map.json (finding 105).
+
+    `.run.lock` is `_run_dir_lock`'s file, never committed (the finalizer's
