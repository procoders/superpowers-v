+                blob = fh.read(REFERENCING_READ_BYTES)
+        except (OSError, IOError):
+            continue
+        text = blob.decode("utf-8", "replace")
+        if any(token in text for token in tokens):
+            out.append({"file": rel, "run": _test_runner_for(rel)})
+            if len(out) >= cap:
+                break
+    return out
